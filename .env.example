# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FOOTBALL_DATA_API_KEY: Primary free tier API token from football-data.org (active).
# Register for a free token at https://www.football-data.org/client/register
# Free tier supports: Premier League (PL), UEFA Champions League (CL), La Liga (PD), Serie A (SA).
# Free tier constraints: 10 requests/minute, delayed match scores (up to 15 min delay).
FOOTBALL_DATA_API_KEY="YOUR_FOOTBALL_DATA_API_KEY"

# SPORTAPI_KEY: Optional free tier API key from sportapi.ai.
# Register at https://sportapi.ai for free developer access.
# Free tier supports: 2,000 requests/day, European domestic cups, UEFA Europa/Conference Leagues, MLS.
# Leave empty if not configured (provider remains disabled; no mock data substituted).
SPORTAPI_KEY="YOUR_SPORTAPI_KEY"

# FIVE_DOLLAR_KEY: Optional free tier API key from 5dollarfootballapi.com.
# Register at https://5dollarfootballapi.com for free access (no credit card required).
# Free tier supports: 60 requests/hour (max 20 req/min), Top 5 European leagues with Bet365 odds markets.
# Leave empty if not configured (provider remains disabled; no mock data substituted).
FIVE_DOLLAR_KEY="YOUR_FIVE_DOLLAR_KEY"

# ODDS_API_KEY: Optional API key from the-odds-api.com.
# Free tier supports: 500 credits/month (costs: markets * regions credits per call).
# Kept disabled by default unless ENABLE_ODDS_API is explicitly set to true.
ODDS_API_KEY="YOUR_ODDS_API_KEY"
ENABLE_ODDS_API="false"

